{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/security/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests", "src/ai-brain", "src/security/agent.ts", "src/security/ai.ts"]
}
